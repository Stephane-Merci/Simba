# Base PostgreSQL
DATABASE_URL="postgresql://simba:simba@localhost:5432/simba?schema=public"

# Port HTTP de l'API
PORT=5001

# Origines autorisées (séparées par des virgules). Vide = toutes.
# Ex. : https://simba.mon-domaine.fr
CORS_ORIGINS=

# Optionnel : servir le frontend compilé depuis l'API (un seul service à déployer)
# STATIC_DIR=../frontend/dist

# Secret de signature des sessions (obligatoire en production, longue chaîne aléatoire).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Durée d'une session de connexion, en heures (défaut : 720 = 30 jours)
# SESSION_HOURS=720
